#!/usr/bin/env bash
set -euo pipefail

version='0.17.0'
checksum='1cbe9df9f27e6b78d14ccbca43b6703a404ef79ef1c463de901d7f088d4e2026'
install_dir="$HOME/.local/share/zeit/zig-$version"

if [[ ! -x "$install_dir/zig" ]]; then
    archive=$(mktemp)
    trap 'rm -f "$archive"' EXIT
    curl -fsSL "https://ziglang.org/download/$version/zig-x86_64-linux-$version.tar.xz" -o "$archive"
    echo "$checksum  $archive" | sha256sum -c -
    mkdir -p "$install_dir"
    tar -xJf "$archive" --strip-components=1 -C "$install_dir"
fi

sudo ln -sfn "$install_dir/zig" /usr/local/bin/zig
zig version
